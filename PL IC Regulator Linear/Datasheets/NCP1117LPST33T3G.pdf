         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">NCP1117LP - Voltage Regulators, 1.0 A Low-Dropout Positive, Fixed and Adjustable</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The NCP1117LP is the low power version of the popular NCP1117&#xD;&#xA;family of low dropout voltage regulators, with reduced quiescent&#xD;&#xA;current.</rdf:li>
            </rdf:Alt>
         </dc:description>
